+// Factor only contiguous alternatives beginning with an actual literal. Capture
+// markers and guards are barriers: no observable capture write is moved.
+fn factor_alternatives(mut v: Vec<Ast>) -> Ast {
+    fn leading(a: &Ast) -> Option<&[u8]> {
+        match a {
+            Ast::Lit(s) if !s.is_empty() => Some(s),
+            Ast::Seq(v) => v.first().and_then(leading),
+            _ => None,
+        }
+    }
+    fn strip(a: Ast, n: usize) -> Ast {
+        match a {
+            Ast::Lit(s) => {
+                if n == s.len() {
+                    Ast::Empty
+                } else {
+                    Ast::Lit(s[n..].to_vec())
+                }
+            }
+            Ast::Seq(mut v) => {
+                let first = strip(v.remove(0), n);
+                if !matches!(first, Ast::Empty) {
+                    v.insert(0, first);
+                }
+                if v.is_empty() {
+                    Ast::Empty
+                } else {
+                    Ast::Seq(v)
+                }
+            }
+            _ => unreachable!("prefix was checked"),
+        }
+    }
+    if v.len() == 1 {
+        return v.pop().unwrap();
+    }
+    let common = leading(&v[0])
+        .map(|s| {
+            let mut n = s.len();
+            for a in &v[1..] {
+                if let Some(t) = leading(a) {
+                    n = n.min(s.iter().zip(t).take_while(|(a, b)| a == b).count());
+                } else {
+                    return 0;
+                }
+            }
+            n
+        })
+        .unwrap_or(0);
+    if common > 0 {
+        let prefix = leading(&v[0]).unwrap()[..common].to_vec();
+        let tail = factor_alternatives(v.into_iter().map(|a| strip(a, common)).collect());
+        return Ast::Seq(vec![Ast::Lit(prefix), tail]);
+    }
+    let mut out = Vec::new();
+    let mut items = v.into_iter().peekable();
+    while let Some(first) = items.next() {
+        let byte = leading(&first).map(|s| s[0]);
+        let mut group = vec![first];
+        if byte.is_some() {
+            while items
+                .peek()
+                .is_some_and(|a| leading(a).map(|s| s[0]) == byte)
+            {
+                group.push(items.next().unwrap());
+            }
+        }
+        out.push(if group.len() > 1 {
+            factor_alternatives(group)
+        } else {
+            group.pop().unwrap()
+        });
+    }
+    Ast::Alt(out)
 }
 
