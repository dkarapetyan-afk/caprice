+    for pattern in [
+        r"(?:(?<x>[ab]{1,3})-){1,5}\k<x>",
+        r"(?:(?<x>[ab]*)-){1,4}b\k<x>",
+    ] {
+        let raw = Engine::new(pattern, Params::new(), Mode::Raw).unwrap();
+        let jit = Engine::new(pattern, Params::new(), Mode::Jit).unwrap();
+        let mut pc = Pcre::new(pattern, true).unwrap();
+        for s in words(b"ab-", 7) {
