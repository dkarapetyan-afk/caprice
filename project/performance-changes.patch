+fn fuse_capture_runs(code: &mut Vec<Inst>) {
+    use std::collections::BTreeSet;
+    let targets: BTreeSet<_> = code
+        .iter()
+        .flat_map(|i| match i {
+            Inst::Split(a, b) | Inst::Switch(_, a, b) => vec![*a, *b],
+            Inst::Jump(a) => vec![*a],
+            _ => vec![],
+        })
+        .collect();
+    let mut next = Vec::with_capacity(code.len());
+    let mut map = vec![0; code.len() + 1];
+    let mut pc = 0;
+    while pc < code.len() {
+        map[pc] = next.len();
+        if let [Inst::SaveStart(id), Inst::AtomicRun(c, n, m), Inst::SaveEnd(end), ..] = &code[pc..]
+        {
+            if id == end && !targets.contains(&(pc + 1)) && !targets.contains(&(pc + 2)) {
+                map[pc + 1] = next.len();
+                map[pc + 2] = next.len();
+                next.push(Inst::CaptureRun(*id, c.clone(), *n, *m));
+                pc += 3;
+                continue;
+            }
+        }
+        next.push(code[pc].clone());
+        pc += 1;
+    }
+    map[code.len()] = next.len();
+    for i in &mut next {
+        match i {
+            Inst::Split(a, b) | Inst::Switch(_, a, b) => {
+                *a = map[*a];
+                *b = map[*b];
+            }
+            Inst::Jump(a) => *a = map[*a],
+            _ => {}
+        }
+    }
+    *code = next;
 }
 
